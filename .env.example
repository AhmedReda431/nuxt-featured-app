# Secret key used to encrypt the session cookie (user data + tokens).
# Generate a strong random value for production, e.g.: openssl rand -base64 32
NUXT_AUTH_SECRET=replace-this-with-a-long-random-secret

# Public site URL, used for canonical links and SEO meta tags
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the products/auth/blog API. Defaults to https://dummyjson.com
# Swap this for your own backend later without touching any page code.
NUXT_PUBLIC_API_BASE=https://dummyjson.com
